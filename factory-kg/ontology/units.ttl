# 生成ファイル（factory-kg/tools/vocab.py）。手で編集しない。
# QUDT Units Vocabulary（http://qudt.org/vocab/unit/、http://qudt.org/vocab/unit）から、使っている単位だけを抜粋。
# QUDT は CC BY 4.0（https://qudt.org/）。日本語ラベル（@ja）のうち QUDT にないものは factory-kg で追加した。

@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

unit:A a qudt:Unit ;
    rdfs:label "Ampere",
        "Ampere"@en,
        "アンペア"@ja ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/CurrentLinkage>,
        <http://qudt.org/vocab/quantitykind/ElectricCurrent>,
        <http://qudt.org/vocab/quantitykind/ElectricCurrentPhasor>,
        <http://qudt.org/vocab/quantitykind/MagneticTension> ;
    qudt:symbol "A" ;
    qudt:ucumCode "A"^^qudt:UCUMcs .

unit:DEG_C a qudt:Unit ;
    rdfs:label "Degree Celsius",
        "Degree Celsius"@en,
        "セルシウス度"@ja ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/BoilingPoint>,
        <http://qudt.org/vocab/quantitykind/CelsiusTemperature>,
        <http://qudt.org/vocab/quantitykind/ColdReceptorThreshold>,
        <http://qudt.org/vocab/quantitykind/DewPointTemperature>,
        <http://qudt.org/vocab/quantitykind/DryBulbTemperature>,
        <http://qudt.org/vocab/quantitykind/FlashPoint>,
        <http://qudt.org/vocab/quantitykind/MeltingPoint>,
        <http://qudt.org/vocab/quantitykind/Temperature>,
        <http://qudt.org/vocab/quantitykind/WetBulbTemperature> ;
    qudt:symbol "°C" ;
    qudt:ucumCode "Cel"^^qudt:UCUMcs .

unit:KiloW a qudt:Unit ;
    rdfs:label "Kilowatt",
        "Kilowatt"@en,
        "キロワット"@ja ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/ElectricPower>,
        <http://qudt.org/vocab/quantitykind/Power> ;
    qudt:symbol "kW" ;
    qudt:ucumCode "kW"^^qudt:UCUMcs .

unit:M-PER-MIN a qudt:Unit ;
    rdfs:label "Metre per Minute",
        "Metre per Minute"@en,
        "メートル毎分"@ja ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/LinearVelocity>,
        <http://qudt.org/vocab/quantitykind/Velocity> ;
    qudt:symbol "m/min" ;
    qudt:ucumCode "m.min-1"^^qudt:UCUMcs .

unit:MegaPA a qudt:Unit ;
    rdfs:label "Megapascal",
        "Megapascal"@en,
        "メガパスカル"@ja ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/ForcePerArea>,
        <http://qudt.org/vocab/quantitykind/ModulusOfElasticity> ;
    qudt:symbol "MPa" ;
    qudt:ucumCode "MPa"^^qudt:UCUMcs .

unit:NUM a qudt:Unit ;
    rdfs:label "Number",
        "Number"@en,
        "個数"@ja ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Count>,
        <http://qudt.org/vocab/quantitykind/MassNumber>,
        <http://qudt.org/vocab/quantitykind/NeutronNumber>,
        <http://qudt.org/vocab/quantitykind/NucleonNumber>,
        <http://qudt.org/vocab/quantitykind/NumberOfElectricalPhases>,
        <http://qudt.org/vocab/quantitykind/NumberOfParticles>,
        <http://qudt.org/vocab/quantitykind/Piece>,
        <http://qudt.org/vocab/quantitykind/Population>,
        <http://qudt.org/vocab/quantitykind/Turns> ;
    qudt:symbol "#" ;
    qudt:ucumCode "{#}"^^qudt:UCUMcs .

unit:PERCENT a qudt:Unit ;
