        <http://qudt.org/vocab/quantitykind/VolumeStrain> ;
    qudt:symbol "%" ;
    qudt:ucumCode "%"^^qudt:UCUMcs .

unit:PPM a qudt:Unit ;
    rdfs:label "Parts per Million",
        "Parts per Million"@en,
        "ppm"@ja ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/AmountOfSubstanceFraction>,
        <http://qudt.org/vocab/quantitykind/DimensionlessRatio>,
        <http://qudt.org/vocab/quantitykind/MoleFraction> ;
    qudt:symbol "PPM" ;
    qudt:ucumCode "[ppm]"^^qudt:UCUMcs .

unit:REV-PER-MIN a qudt:Unit ;
    rdfs:label "Revolution per Minute",
        "Revolution per Minute"@en,
        "毎分回転数"@ja ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/RotationalFrequency>,
        <http://qudt.org/vocab/quantitykind/RotationalVelocity> ;
    qudt:symbol "rev/min" ;
    qudt:ucumCode "{#}.min-1"^^qudt:UCUMcs .

