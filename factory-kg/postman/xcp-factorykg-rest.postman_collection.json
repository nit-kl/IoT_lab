          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 が返る', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. 存在しない設備（→ 404）",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{apiUrl}}/v1/equipment/NOPE-01",
          "host": [
            "{{apiUrl}}"
          ],
          "path": [
